# apps/backend/.env.example
# 실제 값을 채운 .env 파일은 git에 커밋하지 않는다 (.gitignore 처리).
# 각 값의 정책 근거는 우측 주석의 문서를 참고.

# ── Database (docker-compose.yml 기준: 호스트 포트 5433 → 컨테이너 5432) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/tracecare
SPRING_DATASOURCE_USERNAME=tracecare
SPRING_DATASOURCE_PASSWORD=java

# ── Redis (docker-compose.yml의 redis 서비스, 호스트 포트 6379) ──
# Cache_Strategy_Guide.md, Security_Guide.md §5(Refresh Token/JWT Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT (Security_Guide.md §5.1) ──
JWT_SECRET=                      # 최소 256bit 이상, 환경변수/Secrets Manager로만 관리
JWT_ACCESS_TOKEN_EXPIRATION=1800000   # ms, 30분 (Security_Guide.md §5.4)
JWT_REFRESH_TOKEN_EXPIRATION=1209600000 # ms, 14일 (Security_Guide.md §5.4)

# ── Google OAuth2 (Security_Guide.md §6) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ── FastAPI(ai-server) 연동 (Security_Guide.md §11.1, Server-to-Server API Key) ──
AI_SERVER_BASE_URL=http://localhost:8000
AI_SERVER_API_KEY=               # apps/ai-server의 BACKEND_API_KEY와 동일한 값이어야 함

# ── FCM (Firebase Cloud Messaging, 알림 발송) ──
FCM_CREDENTIALS_PATH=./firebase-service-account.json

# ── Guardian 소프트 상한 (DATABASE_DESIGN_GUIDE.md §13/§14, 하드 상한 없음/설정값 관리) ──
GUARDIAN_CARE_TARGET_LIMIT=10

# ── 서버 설정 ──
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
