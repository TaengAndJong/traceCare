# apps/frontend/.env.example
# 실제 값을 채운 .env 파일은 git에 커밋하지 않는다 (.gitignore 처리).
# Flutter는 --dart-define 또는 flutter_dotenv 중 하나로 통일해서 사용(Coding_Convention.md 착수 시 확정).

# ── API 서버 (API_Specification.md, API_Response_Rule.md §7) ──
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080  # /ws/guardian/location, /ws/care-target/location (API_Specification.md §5)

# ── Google OAuth2 로그인 (Security_Guide.md §6) ──
GOOGLE_CLIENT_ID=
