# apps/ai-server/.env.example
# 실제 값을 채운 .env 파일은 git에 커밋하지 않는다 (.gitignore 처리).

# ── Spring Boot ↔ FastAPI 인증 (Security_Guide.md §11.1) ──
# apps/backend의 AI_SERVER_API_KEY와 반드시 동일한 값이어야 함
BACKEND_API_KEY=

# ── LLM 연동 (AI Care Chat, Security_Guide.md §11.5 Prompt Injection 방어 대상) ──
LLM_API_KEY=
LLM_API_BASE_URL=

# ── ML 모델 (방문 예측, Coding_Convention.md §7) ──
MODEL_PATH=./app/models/prediction_model.pkl
HUGGINGFACE_MODEL_REPO=          # 사용 시에만, 커밋 해시 고정 권장(OWASP_Security_Guide.md §3.3)

# ── 서버 설정 ──
PORT=8000
LOG_LEVEL=INFO                   # 운영 환경 기준, 로컬 개발 시 DEBUG로 변경 가능
